# The deploy artifact: built by scripts/build.mjs, never committed.
dist/

# Wrangler / Cloudflare local state
.wrangler/

# Local working dirs (including any leftover Claude-local state)
node_modules/
.claude/
tmp/

# The e2e harness leaves one inspected screenshot. Its logs, kits, build copy,
# and browser profiles live under the OS temp directory.
tests/prof-*/
tests/*.png
tests/tmp/

# Folio Native: JUCE and the WebView2 SDK are fetched by folio-native/build.cmd
folio-native/JUCE/
folio-native/deps/
folio-native/build/
